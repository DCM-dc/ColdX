{
  "name": "coldx-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "ColdX generative workspace built on the native DeepSeek Harness Web client",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node plugin/client/build.mjs",
    "pretest": "node plugin/client/build.mjs",
    "start": "node bin/coldx-web.mjs",
    "computer:install": "node scripts/install-browser.mjs",
    "test": "node --test test/*.test.mjs",
    "desktop:dev": "node scripts/desktop/dev.mjs",
    "desktop:stage": "pnpm build && node scripts/desktop/stage.mjs",
    "desktop:pack": "pnpm desktop:stage && electron-builder --config desktop/electron-builder.cjs --dir",
    "desktop:dist": "pnpm desktop:stage && electron-builder --config desktop/electron-builder.cjs --publish never"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@playwright/mcp": "0.0.80",
    "coldx-client": "link:./plugin/client"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "pdfjs-dist": "6.3.289"
  }
}
